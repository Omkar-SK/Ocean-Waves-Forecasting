# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Testing and cache
.pytest_cache/
.coverage
htmlcov/

# Environment variables
.env
.env.*

# OS generated files
.DS_Store
ehthumbs.db
Thumbs.db

# Large Data files (Preserved locally, excluded from git tracking)
data/*.nc
data/processed/*.parquet
data/processed/*.csv
data/interim/*

# Project specific artifacts
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
outputs/metrics/*.csv
outputs/plots/*.png
outputs/plots/*.pdf
outputs/reports/*.json
outputs/predictions/*.csv

# Keep folders intact in repository
!models/.gitkeep
!outputs/metrics/.gitkeep
!outputs/plots/.gitkeep
!outputs/reports/.gitkeep
!outputs/predictions/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
!data/persistence/.gitkeep

# Node & temporary scratch scripts
node_modules/
scratch/

# Persistence & SQLite
data/persistence/*.db
data/persistence/*.db-journal
data/persistence/*.db-wal
data/persistence/*.db-shm
